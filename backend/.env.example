# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=5000

# PostgreSQL connection
DATABASE_URL=postgresql://username:password@localhost:5432/vakeel_sahab

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI (for the chatbot)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Frontend origin allowed to call this API (CORS)
CLIENT_ORIGIN=http://localhost:3000
